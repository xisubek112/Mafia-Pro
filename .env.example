# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: HTTP & Socket.IO server port (default: 3000)
PORT=3000

# SESSION_SECRET: Strong random secret for signing JWT/HMAC session tokens in production
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"

# DATABASE_URL: PostgreSQL / Supabase connection string (e.g. postgresql://postgres:pass@host:5432/postgres)
# When omitted, the server automatically falls back to local JSON persistence (data/db.json).
DATABASE_URL=""

# CORS_ORIGIN: Allowed frontend origin in production (e.g. https://mafiapro.uz or *)
CORS_ORIGIN="*"

# VITE_SOCKET_URL: Optional external Socket.IO backend URL if frontend and backend are hosted separately
VITE_SOCKET_URL=""

# PAYMENT SYSTEM CONFIGURATION (UZS - Payme / Click / Sandbox)
# PAYMENT_MODE: "sandbox" for test mode, "production" for live gateway callbacks
PAYMENT_MODE="sandbox"
PAYMENT_WEBHOOK_SECRET="dev-sandbox-webhook-secret-change-in-prod"

# Payme Merchant Integration (https://developer.payme.uz)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_CHECKOUT_URL="https://checkout.paycom.uz"

# Click Merchant Integration (https://docs.click.uz)
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
CLICK_CHECKOUT_URL="https://my.click.uz/services/pay"

